# Previews of XISF, FITS and ASDF images in the file managers that use thumbnailer entries
# (GNOME Files, Nemo, Caja, Thunar, PCManFM). Installed to <prefix>/share/thumbnailers/, or
# copied to ~/.local/share/thumbnailers/. See "Previews in the file manager" in the README.
# SPDX-License-Identifier: LGPL-3.0-or-later
[Thumbnailer Entry]
TryExec=xisfconv
Exec=xisfconv --quiet --force --to png --stretch --bits u8 --resize %s --output %o -- %i
MimeType=image/x-xisf;image/xisf;application/x-xisf;application/fits;image/fits;image/x-fits;application/x-asdf;
